table USERS:
ID INTEGER PRIMARY KEY AUTOINCREMENT,
FIRSTNAME VARCHAR(16),
LASTNAME VARCHAR(16),
INVENTORYNAME VARCHAR(16),
USERNAME VARCHAR(16) UNIQUE,
PASSWORD VARCHAR(32)

table ITEMS:
ID INTEGER PRIMARY KEY AUTOINCREMENT,
OWNER VARCHAR(16),
NAMEITEM VARCHAR(16),
TYPEITEM VARCHAR(16),
CATEGORY VARCHAR(16),
AMOUNT INTEGER,
PRICE INTEGER

table ACTIONS:
ID INTEGER PRIMARY KEY AUTOINCREMENT,
OWNER VARCHAR(16),
NAMEITEM VARCHAR(16),
ACTION VARCHAR(16) UNIQUE,
AMOUNT VARCHAR(32),
TIME DATETIME

table TRANSACTIONS:
ID INTEGER PRIMARY KEY AUTOINCREMENT,
OWNER VARCHAR(16),
NAMEITEM VARCHAR(16),
ACTION VARCHAR(16) UNIQUE,
AMOUNT INTEGER,
TOTAL VALUE INTEGER
TIME DATETIME