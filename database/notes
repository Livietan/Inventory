table USER:
ID INTEGER PRIMARY KEY AUTOINCREMENT,
FIRSTNAME VARCHAR(16),
LASTNAME VARCHAR(16),
USERNAME VARCHAR(16) UNIQUE,
PASSWORD VARCHAR(32)

table ITEMS:
ID INTEGER PRIMARY KEY AUTOINCREMENT,
OWNER VARCHAR(64),
NAMEITEM VARCHAR(16),
TYPEITEM VARCHAR(16),
CATEGORY VARCHAR(16),
AMOUNT INT,
PRICE INT

table ACTIONS:
ID INTEGER PRIMARY KEY AUTOINCREMENT,
OWNER VARCHAR(64),
NAMEITEM VARCHAR(16),
ACTION VARCHAR(16) UNIQUE,
AMOUNT VARCHAR(32),
TIME DATETIME

table TRANSACTIONS:
ID INTEGER PRIMARY KEY AUTOINCREMENT,
OWNER VARCHAR(64),
NAMEITEM VARCHAR(16),
ACTION VARCHAR(16) UNIQUE,
AMOUNT VARCHAR(32),
VALUE/ITEM INT,
TOTAL VALUE INT
TIME DATETIME